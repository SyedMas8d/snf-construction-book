              "path": ["contractors"],
              "query": [{ "key": "site", "value": "{{siteId}}" }]
            }
          }
        },
        {
          "name": "Create Contractor",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
