{
  "info": {
    "_postman_id": "b7e2f4a0-6c1a-4b2e-9c3d-construction-inv-01",
    "name": "Construction Inventory API",
    "description": "Sites, Contractors, Daily Logs, Wages, and Inventory endpoints for the construction-inventory backend. Run 'Sites > Create Site' then 'Contractors > Create Contractor' first — they auto-populate {{siteId}} and {{contractorId}} used by the Wages folder.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{authToken}}", "type": "string" }]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:4000", "type": "string" },
    { "key": "authToken", "value": "test-token", "type": "string" },
    { "key": "siteId", "value": "", "type": "string" },
    { "key": "contractorId", "value": "", "type": "string" },
    { "key": "dailyLogId", "value": "", "type": "string" },
    { "key": "wageId", "value": "", "type": "string" },
    { "key": "inventoryId", "value": "", "type": "string" },
    { "key": "transactionId", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] }
          }
        }
      ]
    },
    {
      "name": "Sites",
      "item": [
        {
          "name": "List Sites",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/sites", "host": ["{{baseUrl}}"], "path": ["sites"] }
          }
        },
        {
          "name": "Create Site",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const body = pm.response.json();",
                  "  pm.collectionVariables.set('siteId', body._id);",
                  "  console.log('siteId set to', body._id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Riverside Block A\",\n  \"address\": \"12 River Rd\",\n  \"client\": \"Acme Corp\",\n  \"startDate\": \"2026-08-18\",\n  \"status\": \"active\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/sites", "host": ["{{baseUrl}}"], "path": ["sites"] }
          }
        },
        {
          "name": "Get Site By Id",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/sites/{{siteId}}", "host": ["{{baseUrl}}"], "path": ["sites", "{{siteId}}"] }
          }
        },
        {
          "name": "Update Site",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"completed\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/sites/{{siteId}}", "host": ["{{baseUrl}}"], "path": ["sites", "{{siteId}}"] }
          }
        },
        {
          "name": "Delete Site",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": { "raw": "{{baseUrl}}/sites/{{siteId}}", "host": ["{{baseUrl}}"], "path": ["sites", "{{siteId}}"] }
          }
        }
      ]
    },
    {
      "name": "Contractors",
      "item": [
        {
