              "raw": "{{baseUrl}}/contractors/{{contractorId}}",
              "host": ["{{baseUrl}}"],
              "path": ["contractors", "{{contractorId}}"]
            }
          }
        },
        {
          "name": "Update Contractor (add worker type)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"workerTypes\": [\"Mason\", \"MC\", \"Machine rent\", \"Plumber\"]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/contractors/{{contractorId}}",
              "host": ["{{baseUrl}}"],
              "path": ["contractors", "{{contractorId}}"]
            }
          }
        },
        {
          "name": "Delete Contractor",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/contractors/{{contractorId}}",
              "host": ["{{baseUrl}}"],
              "path": ["contractors", "{{contractorId}}"]
            }
          }
        }
      ]
    },
